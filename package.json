{
  "name": "@tzwzx/expo-oxc-config",
  "version": "0.2.0",
  "description": "Shared oxlint/oxfmt toolchain + config for the Expo app fleet (ultracite wrapper with ignorePatterns fix and common rules)",
  "license": "MIT",
  "repository": "github:tzwzx/expo-oxc-config",
  "type": "module",
  "exports": {
    "./oxlint": "./oxlint.mjs",
    "./oxfmt": "./oxfmt.mjs"
  },
  "files": [
    "oxlint.mjs",
    "oxlint.d.mts",
    "oxfmt.mjs",
    "oxfmt.d.mts"
  ],
  "dependencies": {
    "eslint-plugin-github": "6.1.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-plugin-react-doctor": "0.9.2",
    "ultracite": "7.9.4"
  },
  "scripts": {
    "verify": "bun scripts/verify.ts",
    "rulesync": "bunx rulesync install && bunx rulesync generate && .rulesync/scripts/post-generate.sh",
    "lint": "oxfmt --check --disable-nested-config && oxlint --disable-nested-config --report-unused-disable-directives-severity=error",
    "fix": "oxfmt --disable-nested-config && oxlint --disable-nested-config --fix"
  }
}
