{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": {
    "cursor": ["rules"],
    "claudecode": ["rules", "skills"],
    "agentsmd": { "rules": { "ruleDiscoveryMode": "none" } },
  },
  "sources": [
    {
      "source": "https://github.com/tzwzx/expo-ai-standards.git",
      "transport": "git",
      "rules": [
        "en-claudecode-entry",
        "en-critical-rules",
        "en-rules-architecture",
        "ja-commit-message",
      ],
    },
  ],
  "delete": true,
}
